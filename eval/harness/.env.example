# Eval Harness Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# ============================================
# Z.AI API (REQUIRED)
# ============================================
# Get an API key from: https://z.ai
ZAI_API_KEY=your_api_key_here

# Base URL for z.ai API (optional, has default)
# ZAI_BASE_URL=https://api.z.ai/api/anthropic

# ============================================
# TOOL API KEYS
# ============================================

# Tavily (web search + extract)
# Get one at: https://tavily.com/
TAVILY_API_KEY=tvly-...

# ============================================
# RESEARCH MCP SERVER
# ============================================

# URL of the research index MCP server
RESEARCH_MCP_URL=http://127.0.0.1:9223/mcp

# Path to the research database file
RESEARCH_DB_PATH=research.db

# ============================================
# EVAL SETTINGS
# ============================================

# Model to use for eval runs (GLM-4.7 or GLM-4.5-Air)
EVAL_MODEL_ID=GLM-4.7

# Number of runs per condition
EVAL_RUNS_PER_CONDITION=5

# Output directory for results
EVAL_RESULTS_DIR=./results

# Snapshot directory for database copies
EVAL_SNAPSHOTS_DIR=./snapshots

# Traces directory for conversation logs (gitignored)
EVAL_TRACES_DIR=./traces
